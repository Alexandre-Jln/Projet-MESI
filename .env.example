# =============================================================
#  PotCommun – Variables d'environnement
#  Windows  : copy .env.example .env
#  Mac/Linux: cp .env.example .env
# =============================================================

MYSQL_ROOT_PASSWORD=change_me_root_123!
MYSQL_DATABASE=potcommun
MYSQL_USER=potcommun_user
MYSQL_PASSWORD=potcommun_pass

# Clé AES-256 pour le chiffrement des emails
# Génère la tienne : openssl rand -base64 32
APP_ENCRYPTION_KEY=REMPLACE_MOI_avec_openssl_rand_-base64_32

# ── Stripe ────────────────────────────────────────────────────
# Récupère ces clés sur https://dashboard.stripe.com/test/apikeys
# (assure-toi d'être en mode TEST)
STRIPE_SECRET_KEY=sk_test_REMPLACE_MOI
STRIPE_WEBHOOK_SECRET=whsec_REMPLACE_MOI

# Clé publique Stripe pour le frontend (préfixe VITE_ obligatoire)
# À mettre dans frontend/.env (pas à la racine)
# VITE_STRIPE_PUBLIC_KEY=pk_test_REMPLACE_MOI
